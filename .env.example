# Copy to .env (cp .env.example .env) or run `npm run setup`. Real environment variables override .env.

# Required: bot credentials from q.qq.com. The AppSecret is shown once; viewing it again resets it.
QQBOT_APP_ID=1000000000
QQBOT_APP_SECRET=replace-with-your-app-secret
# Optional OpenAPI base (default https://api.sgroup.qq.com). Must be https on a qq.com host.
# QQBOT_API_BASE=https://api.sgroup.qq.com

# Required: HTTPS endpoint that receives one JSON POST per forwarded message
# (e.g. a Grok Bot routine's Webhook URL; any HTTP webhook works).
FORWARD_WEBHOOK_URL=https://example.com/your-webhook
# Optional: full Authorization header value sent with each POST (for a Grok Bot routine: "Bearer <key>").
FORWARD_WEBHOOK_AUTH="Bearer replace-with-your-token"

# Owner protection (off by default; setup asks): on forwards only the bound owner (+ ALLOWLIST), rate-limited,
# marked untrusted. off forwards every sender, no binding, and marks EVERY payload trusted (untrusted=false),
# including messages from strangers.
OWNER_PROTECTION=off
# Optional explicit owner openid (recommended with protection on). Without it, the FIRST account that messages the
# bot becomes the owner, so message the bot yourself right after starting it.
OWNER_ID=
# Optional comma-separated extra openids allowed when protection is on.
ALLOWLIST=
# Per-sender messages per minute when protection is on (0 disables).
RATE_LIMIT_PER_MIN=20
# Messages per minute from all senders together, in both modes (0 disables).
GLOBAL_RATE_LIMIT_PER_MIN=60
# Longer inbound messages are truncated (0 disables).
MAX_MESSAGE_CHARS=4000

# Passed to the receiving agent as "mirror" in every payload: should it copy channel conversations to its main chat?
MIRROR_TO_MAIN_CHAT=true

# Inbound media (images, voice, files, video): saved under MEDIA_DIR and listed in the payload's "media" array.
# false: no downloads and no "media" array (voice transcripts are still forwarded as text).
ACCEPT_MEDIA=true
# Optional media settings (defaults shown): directory, per-file cap in MB, and age in days after which files are deleted (0 keeps them).
# MEDIA_DIR=state/media
# MEDIA_MAX_MB=100
# MEDIA_RETENTION_DAYS=7
# Extra host names media may be downloaded from (Tencent hosts are always allowed), comma-separated.
# MEDIA_ALLOWED_HOSTS=
# Optional: reply.sh only sends files from these directories (colon- or comma-separated). Secrets are always refused.
# REPLY_ALLOWED_DIRS=

# Healthcheck: report STALE when no gateway frame arrived for this many seconds.
HEALTH_STALE_SECONDS=180
# Optional locations (default: ./state and ./logs).
# STATE_DIR=state
# LOG_DIR=logs
# On stop, milliseconds that messages in progress may take to finish (unfinished ones go to undelivered.jsonl).
# BRIDGE_STOP_GRACE_MS=10000
# Allow a plain-http webhook on a non-localhost host (not recommended).
# FORWARD_ALLOW_INSECURE_HTTP=0
